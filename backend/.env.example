# 경찰청 실종자 API 키
DATA_GO_KR_API_KEY=your_data_go_kr_service_key

# 행정안전부 재난문자 API 키
SAFETY_DATA_API_KEY=your_safetydata_go_kr_service_key

# 안전드림(Safe182) 실종자 API 인증 정보
SAFE182_ESNTL_ID=10000847
SAFE182_AUTH_KEY=f16ae98f22b44441

# Firebase 설정
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Google Geocoding API 키 (정확한 좌표 계산용, 선택이지만 권장)
GOOGLE_GEOCODING_API_KEY=AIzaSyAB_7c_8BUfppLCavXQ7onHqwT2n0lnYj0

# 관리자 이메일 목록 (쉼표로 구분, 개발 환경용)
ADMIN_EMAILS=admin@example.com,developer@example.com

# Google reCAPTCHA v3 설정
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
RECAPTCHA_MIN_SCORE=0.5

# CORS 설정 (배포 환경)
# 허용할 프론트엔드 도메인 (쉼표로 구분)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.firebaseapp.com
# 또는 단일 프론트엔드 URL
FRONTEND_URL=https://your-frontend.vercel.app

# 서버 포트
PORT=3000
WS_PORT=8080

# 폴링 간격 (밀리초)
POLL_INTERVAL_EMERGENCY=10000
POLL_INTERVAL_GENERAL=30000

# 자동 발견 처리 기간 (일 단위)
# API에서 이 기간 동안 나타나지 않으면 자동으로 'found' 처리
AUTO_MARK_FOUND_DAYS=7

# 환경
NODE_ENV=development
