{
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/missing",
        "function": "api"
      },
      {
        "source": "/missing/**",
        "function": "api"
      },
      {
        "source": "/sitemap-missing-persons.xml",
        "function": "api"
      },
      {
        "source": "/sitemaps/**",
        "function": "api"
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/search",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow, noarchive"}]
      },
      {
        "source": "/reports",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow, noarchive"}]
      },
      {
        "source": "/reports/**",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow, noarchive"}]
      },
      {
        "source": "/admin",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
      },
      {
        "source": "/admin/**",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
      },
      {
        "source": "/profile",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]
      },
      {
        "source": "/privacy",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow, noarchive"}]
      },
      {
        "source": "/alerts",
        "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow, noarchive"}]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false }
  }
}
