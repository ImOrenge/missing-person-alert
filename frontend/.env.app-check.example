# Firebase Console에서 웹 App Check 앱을 등록한 뒤 monitor mode로 먼저 검증한다.
REACT_APP_FIREBASE_APP_CHECK_ENABLED=false
REACT_APP_FIREBASE_APP_CHECK_SITE_KEY=replace-with-public-recaptcha-enterprise-site-key

# 로컬 개발 전용. true이면 Firebase SDK가 debug token을 생성하며 production에서는 무시된다.
REACT_APP_FIREBASE_APP_CHECK_DEBUG=false

# Analytics P0/P1 allowlist 이벤트는 production 속성·내부 트래픽 필터 확인 후 활성화한다.
REACT_APP_PUBLIC_IMPACT_ANALYTICS_ENABLED=false
