{
  "multipass": true,
  "js2svg": {
    "indent": 2,
    "pretty": true
  },
  "plugins": [
    {
      "name": "preset-default",
      "params": {
        "overrides": {
          "cleanupIDs": false,
          "removeViewBox": false,
          "removeUnknownsAndDefaults": {
            "keepDataAttrs": true
          }
        }
      }
    }
  ]
}
