{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "reports:migrate:dry-run": "npm run build && node scripts/migrate-legacy-reports.js",
    "reports:migrate:verify": "npm run build && node scripts/migrate-legacy-reports.js --verify",
    "reports:migrate:apply": "npm run build && node scripts/migrate-legacy-reports.js --apply",
    "reports:migrate:rollback": "npm run build && node scripts/migrate-legacy-reports.js --rollback",
    "reports:role": "node scripts/set-reporting-role.js",
    "sources:backfill:dry-run": "node scripts/backfill-source-trace.js",
    "sources:backfill:apply": "node scripts/backfill-source-trace.js --apply",
    "test:public-projection": "npm run build && node lib/publicMissingPersons.test.js",
    "test:statistics": "npm run build && node lib/statistics/normalize.test.js",
    "test:public-data-roles": "npm run build && node lib/publicDataRoles.test.js",
    "test:impact-model": "npm run build && node lib/impact/model.test.js",
    "test:share-page": "npm run build && node lib/share/sharePage.test.js",
    "algolia:sync:dry-run": "npm run build && node scripts/sync-algolia-public-search.js",
    "algolia:sync:apply": "npm run build && node scripts/sync-algolia-public-search.js --apply --confirm=missingalert-prod-algolia-sync"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "geofire-common": "^6.0.0",
    "iconv-lite": "^0.6.3",
    "csv-parse": "^5.5.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "overrides": {
    "form-data@<2.5.6": "2.5.6"
  },
  "private": true
}
